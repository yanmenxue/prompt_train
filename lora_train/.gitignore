dataset/*.jsonl
dataset/gen.log

# ---- 凭证/密钥（绝不能进 git）----
*.env
.env
secrets.json
*_api.txt
bailian_api.txt

# ---- IDE / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db
